{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "build",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?!api(?:/|$)|cable(?:/|$))(.*)",
      "dest": "/index.html"
    }
  ]
}
